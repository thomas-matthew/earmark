# Earmark settings. Copy to .env (never committed) and fill in:
#   cp .env.example .env && chmod 600 .env
# See README.md, "Setup", for how to get each value.

# --- Sources ----------------------------------------------------------------------------------

# Substack: the value of the `substack.sid` cookie from a signed-in browser on substack.com
SUBSTACK_SID=

# Reddit: the value of the `reddit_session` cookie from a signed-in browser on reddit.com
REDDIT_SESSION=
REDDIT_USERNAME=

# X: OAuth 2.0 client from developer.x.com (app type "Web App", callback http://127.0.0.1:8723/callback).
# After filling these in, run `uv run earmark x-auth` once to approve read access.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Hacker News: your username. Favorites are public, so no login is needed.
HN_USERNAME=

# --- Feed server (Tailscale) ------------------------------------------------------------------

# This Mac's Tailscale address (`tailscale ip -4`), so the feed is never served on other networks.
EARMARK_HOST=100.x.y.z
EARMARK_PORT=8765
# The address the phone uses: the Mac's MagicDNS name (or its Tailscale IP), plain HTTP.
EARMARK_BASE_URL=http://your-mac.your-tailnet.ts.net:8765

# --- Alerts -------------------------------------------------------------------------------------

# A long random topic name; subscribe to it in the ntfy phone app.
# Generate one with: python3 -c "import secrets; print('earmark-' + secrets.token_hex(12))"
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- Optional -----------------------------------------------------------------------------------

# X pay-per-use: estimated cost per post or user read, and the monthly alert threshold in USD.
# X_COST_PER_READ=0.005
# X_MONTHLY_ALERT=5

# Days to keep episode audio before deleting it (the record of processed items is kept).
# EARMARK_RETENTION_DAYS=30

# Where the database, feed and logs live (default: ./data).
# EARMARK_DATA=

# Fallback: use an Anthropic API key instead of the Claude subscription login.
# EARMARK_USE_API_KEY=1
# ANTHROPIC_API_KEY=
